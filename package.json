{
  "name": "jiskta",
  "version": "0.1.0",
  "description": "Node.js SDK for the Jiskta Climate Data API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "climate",
    "air-quality",
    "no2",
    "pm25",
    "cams",
    "era5",
    "copernicus",
    "jiskta"
  ],
  "author": "Jiskta",
  "license": "MIT",
  "homepage": "https://jiskta.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fvsever/jiskta-node.git"
  },
  "bugs": {
    "url": "https://github.com/fvsever/jiskta-node/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.3"
  }
}
